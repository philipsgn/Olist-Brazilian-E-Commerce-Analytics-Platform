# =============================================================================
# Olist E-commerce Analytics - Production-Ready Environment Template
# Copy this file to `.env` and fill in environment-specific values.
# Keep real secrets in AWS Secrets Manager / SSM Parameter Store / CI secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
ENVIRONMENT=staging
AIRFLOW_UID=50000
AIRFLOW_GID=0
PYTHONPATH=/opt/airflow
SESSION_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Internal Docker Postgres (Airflow + Superset metadata)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=de_user
POSTGRES_PASSWORD=de_password
POSTGRES_DB=ecommerce_db
POSTGRES_AIRFLOW_DB=airflow
POSTGRES_SUPERSET_DB=superset
# Use require when POSTGRES_HOST points to AWS RDS.
POSTGRES_SSLMODE=prefer
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5433

# -----------------------------------------------------------------------------
# AWS RDS / Analytics Warehouse
# -----------------------------------------------------------------------------
# Use RDS credentials for analytics warehouse connections only.
# For local Docker Compose, set RDS_HOST=postgres to target the same local Postgres instance.
RDS_HOST=postgres
RDS_PORT=5432
RDS_USER=change_me
RDS_PASSWORD=change_me
RDS_DB=ecommerce_db
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Airflow
# -----------------------------------------------------------------------------
AIRFLOW_BIND_ADDRESS=0.0.0.0
AIRFLOW_WEBSERVER_HOST_PORT=8080
AIRFLOW_FERNET_KEY=replace_with_generated_fernet_key
AIRFLOW_WEBSERVER_SECRET_KEY=replace_with_random_secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_FIRSTNAME=Data
AIRFLOW_ADMIN_LASTNAME=Engineer

# -----------------------------------------------------------------------------
# Superset
# -----------------------------------------------------------------------------
SUPERSET_BIND_ADDRESS=0.0.0.0
SUPERSET_HOST_PORT=8088
# apache/superset image default user UID (do not run Superset as root).
SUPERSET_UID=1000
SUPERSET_GID=1000
SUPERSET_SECRET_KEY=replace_with_random_secret
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_ADMIN_FIRSTNAME=BI
SUPERSET_ADMIN_LASTNAME=Admin

# -----------------------------------------------------------------------------
# AWS / S3 / Streaming
# -----------------------------------------------------------------------------
AWS_DEFAULT_REGION=ap-southeast-1
S3_BUCKET=replace_with_bucket_name
USE_S3=false
STREAMING_CHECKPOINT_FILE=/opt/airflow/tmp/streaming_checkpoint.txt

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------

DISCORD_WEBHOOK_URL=replace_with_discord_webhook
