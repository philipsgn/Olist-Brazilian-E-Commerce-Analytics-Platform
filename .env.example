# =============================================================================
# Olist E-commerce Analytics - Production-Ready Environment Template
# Copy this file to `.env` and fill in environment-specific values.
# Keep real secrets in AWS Secrets Manager / SSM Parameter Store / CI secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
ENVIRONMENT=staging
AIRFLOW_UID=50000
AIRFLOW_GID=0
PYTHONPATH=/opt/airflow
SESSION_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# PostgreSQL (container-internal settings + optional host publishing)
# -----------------------------------------------------------------------------
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ecommerce_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5433

# -----------------------------------------------------------------------------
# Airflow
# -----------------------------------------------------------------------------
AIRFLOW_BIND_ADDRESS=0.0.0.0
AIRFLOW_WEBSERVER_HOST_PORT=8080
AIRFLOW_FERNET_KEY=replace_with_generated_fernet_key
AIRFLOW_WEBSERVER_SECRET_KEY=replace_with_random_secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_FIRSTNAME=Data
AIRFLOW_ADMIN_LASTNAME=Engineer

# -----------------------------------------------------------------------------
# Superset
# -----------------------------------------------------------------------------
SUPERSET_BIND_ADDRESS=0.0.0.0
SUPERSET_HOST_PORT=8088
SUPERSET_SECRET_KEY=replace_with_random_secret
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_ADMIN_FIRSTNAME=BI
SUPERSET_ADMIN_LASTNAME=Admin

# -----------------------------------------------------------------------------
# AWS / S3 / Streaming
# -----------------------------------------------------------------------------
AWS_DEFAULT_REGION=ap-southeast-1
S3_BUCKET=replace_with_bucket_name
USE_S3=false
STREAMING_CHECKPOINT_FILE=/opt/airflow/tmp/streaming_checkpoint.txt

# -----------------------------------------------------------------------------
# dbt / RDS
# -----------------------------------------------------------------------------
RDS_HOST=replace_with_rds_endpoint
RDS_PORT=5432
RDS_USER=replace_with_rds_user
RDS_PASSWORD=replace_with_rds_password
RDS_DBNAME=ecommerce_db
SSL_CERT_PATH=/opt/airflow/certs/global-bundle.pem
DBT_DEV_HOST=localhost
DBT_DEV_PORT=5432
DBT_DEV_USER=de_user
DBT_DEV_PASSWORD=de_password
DBT_DEV_DBNAME=ecommerce_db
DBT_DEV_SCHEMA=analytics_dev

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=replace_with_discord_webhook
