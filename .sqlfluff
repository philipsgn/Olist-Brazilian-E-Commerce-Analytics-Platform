[sqlfluff]
dialect = postgres
# Use 'jinja' templater instead of 'dbt' to avoid requiring a live DB connection.
# The 'dbt' templater compiles the full project (needs DB), which fails in CI
# because the ephemeral PostgreSQL service does not support SSL.
# The 'jinja' templater stubs dbt macros (ref, source, config) locally.
templater = jinja
max_line_length = 120
# RF04: keywords-as-identifiers — already handled by renaming columns
# ST06: wildcard column order — restructured models to use CTEs
exclude_rules = RF04, ST06

[sqlfluff:templater:jinja]
# Stub all dbt-specific built-in macros so sqlfluff can parse files without a DB
apply_dbt_builtins = true
